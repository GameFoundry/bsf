// Constants and helpers shared by the BC6H (UF16 / unsigned half-float HDR) kernels. The per-mode headers
// (TextureCompressBC6Mode*.bslinc) only pack a mode's scattered endpoint bit layout.
//
// Pipeline (all integer, matching the hardware decoder):
//   input half-float bits h in [0, 0x7BFF]  --QuantizeBC6(prec)-->  endpoint code
//   code  --UnquantizeBC6(prec)-->  16-bit value  --lerp(weights)-->  16-bit value  --FinishUnquantizeBC6-->  half bits
// Endpoints are fitted in the FinishUnquantize (half-bit) space, which is where the decoded palette lives. The two-region
// modes use the first 32 two-subset BC7 partitions, with the same anchors, and the BC7 index weights.
#include "$ENGINE$\TextureCompression\TextureCompressBC7SubsetFit.bslinc"

mixin TextureCompressBC6Common
{
	mixin TextureCompressBC7SubsetFit;

	code
	{
		// Largest finite half-float bit pattern the encoder produces
		#define BC6_MAXIMUM_HALF_BITS 31743.0f

		// Converts a texel to the half-float bits the encoder fits: negatives clamped to 0 and values clamped to the largest
		// finite half. f32tof16 is used per component (the cross-compiler supports only the scalar form).
		float4 GetBC6HalfBits(float4 texel)
		{
			return float4((float)min(f32tof16(max(texel.r, 0.0f)), 0x7BFFu), (float)min(f32tof16(max(texel.g, 0.0f)), 0x7BFFu),
				(float)min(f32tof16(max(texel.b, 0.0f)), 0x7BFFu), 0.0f);
		}

		// Forward endpoint quantization (UF16): half-float bits -> @p prec-bit code. Inverse of the decode chain
		// (Unquantize then FinishUnquantize)
		int QuantizeBC6(int h, int prec)
		{
			if (prec <= 1) return 0;
			if (h < 0) h = 0;
			int bias = (prec > 10 && prec != 16) ? int((1u << (prec - 11)) - 1u) : 0;
			if (prec == 16) bias = 15;
			return ((h << prec) + bias) / 31744; // 31744 = 0x7C00 = F16_MAX_BITS + 1
		}

		// Endpoint unquantization (UF16): @p prec-bit code -> 16-bit value.
		int UnquantizeBC6(int q, int prec)
		{
			if (prec >= 15) return q;
			if (q == 0) return 0;
			if (q == int((1u << prec) - 1u)) return 0xFFFF;
			return ((q << 16) + 0x8000) >> prec;
		}

		int3 UnquantizeBC6Vector(int3 code, int prec)
		{
			return int3(UnquantizeBC6(code.x, prec), UnquantizeBC6(code.y, prec), UnquantizeBC6(code.z, prec));
		}

		// Clamps a float endpoint (half-bit space) to the representable UF16 range and rounds to an int.
		int RoundHalfBits(float v)
		{
			return (int)round(clamp(v, 0.0f, BC6_MAXIMUM_HALF_BITS));
		}

		// Sign-extends the low @p bits of @p v to a full int (matches the decoder's SIGN_EXTEND).
		int SignExtendBC6(int v, int bits)
		{
			return (v & int(1u << (bits - 1))) ? (v | int(~0u << bits)) : v;
		}

		// Quantizes an RGB endpoint (half-bit space floats) to a per-channel absolute @p wBits code.
		int3 QuantizeVecBC6(float4 e, int wBits)
		{
			return int3(QuantizeBC6(RoundHalfBits(e.x), wBits), QuantizeBC6(RoundHalfBits(e.y), wBits), QuantizeBC6(RoundHalfBits(e.z), wBits));
		}

		// Converts the absolute code of an endpoint to the form the mode stores it in, and returns the code the decoder
		// reconstructs from that. Transformed modes store the endpoint as a @p tBits signed delta from @p base, the
		// absolute code of the block's first endpoint.
		//
		// The delta is clamped to the signed tBits range, and further so the decoder's reconstruction (sign-extended delta
		// + base) stays within [0, wmask] without wrapping. The hardware decodes the endpoint as (SIGN_EXTEND(delta) + base)
		// & MASK(wBits); a delta whose magnitude exceeds the field wraps to a near-max code that unquantizes to ~65504 (a
		// firefly), even when both endpoints are individually in range. Clamping keeps the reconstruction in range, so a
		// block whose endpoints are too far apart for this mode just has a larger error and loses mode selection.
		int3 TransformBC6Endpoint(int3 code, int3 base, int wBits, int3 tBits, bool transformed, out int3 outStoredCode)
		{
			if (!transformed)
			{
				outStoredCode = code;
				return code;
			}

			const int wmask = int((1u << wBits) - 1u);
			int3 decodedCode = int3(0, 0, 0);
			outStoredCode = int3(0, 0, 0);
			[unroll]
			for (uint channel = 0u; channel < 3u; ++channel)
			{
				const int deltaBits = tBits[channel];
				const int lowest = -int(1u << (deltaBits - 1));
				const int highest = int((1u << (deltaBits - 1)) - 1u);
				const int delta = clamp(code[channel] - base[channel], max(lowest, -base[channel]), min(highest, wmask - base[channel]));
				const int storedDelta = delta & int((1u << deltaBits) - 1u);
				outStoredCode[channel] = storedDelta;
				decodedCode[channel] = (SignExtendBC6(storedDelta, deltaBits) + base[channel]) & wmask;
			}

			return decodedCode;
		}

		// Finds the @p indexBits-bit index whose decoded palette entry is closest to @p texel (half bits, RGB) and returns
		// the squared distance to it. Ties keep the lower index. @p unquantized0 and @p unquantized1 are the endpoints
		// after UnquantizeBC6; the palette entry is the decoder's FinishUnquantize of their 6-bit weighted blend.
		float FindBC6Index(int3 texel, int3 unquantized0, int3 unquantized1, uint indexBits, out uint outIndex)
		{
			uint bestDistance = 0xFFFFFFFFu;
			outIndex = 0u;
			for (uint index = 0u; index < (1u << indexBits); ++index)
			{
				const int weight = (int)GetBC7IndexWeight(index, indexBits);
				const int3 difference = texel - (((unquantized0 * (64 - weight) + unquantized1 * weight) >> 6) * 31 >> 6);

				// Each squared channel difference fits in 31 bits and their sum in 32
				const uint distance = (uint)(difference.x * difference.x) + (uint)(difference.y * difference.y) + (uint)(difference.z * difference.z);
				if (distance < bestDistance)
				{
					bestDistance = distance;
					outIndex = index;
				}
			}

			return (float)bestDistance;
		}

		// Returns the squared distance of @p texel to palette entry @p index
		float GetBC6PaletteDistance(int3 texel, int3 unquantized0, int3 unquantized1, uint index, uint indexBits)
		{
			const int weight = (int)GetBC7IndexWeight(index, indexBits);
			const int3 difference = texel - (((unquantized0 * (64 - weight) + unquantized1 * weight) >> 6) * 31 >> 6);
			return (float)((uint)(difference.x * difference.x) + (uint)(difference.y * difference.y) + (uint)(difference.z * difference.z));
		}

		// Solves for the endpoints that minimize the squared error for the accumulated weights, clamped to the bounding box
		// of the subset's texels. Keeps the current endpoints if the system is singular. As the index distribution approaches
		// degenerate (nearly all texels at one end) the determinant shrinks toward 0 while passing the singularity guard,
		// and the unclamped solution lands far past the data. Such an endpoint quantizes to BC6H's reserved all-ones code
		// and decodes to 65504 (a firefly).
		void SolveBC6LeastSquares(BC7LeastSquares leastSquares, float4 minimum, float4 maximum, inout float4 endpoint0, inout float4 endpoint1)
		{
			const float3 terms = leastSquares.Terms;
			const float determinant = terms.x * terms.z - terms.y * terms.y;
			if (abs(determinant) > 1e-9f)
			{
				const float inverseDeterminant = 1.0f / determinant;
				endpoint0 = clamp((terms.z * leastSquares.SumA - terms.y * leastSquares.SumB) * inverseDeterminant, minimum, maximum);
				endpoint1 = clamp((terms.x * leastSquares.SumB - terms.y * leastSquares.SumA) * inverseDeterminant, minimum, maximum);
			}
		}
	};
};
