// BC1 (DXT1) encoding of a 4x4 RGB block into a 64-bit block, shared by BC1 and BC3's color half
// (TextureCompressBC1.bsl). The texels of the blocks a group encodes live in groupshared memory, 4 blocks per group.
// Endpoints come from a cluster fit (in the kernel), followed by 5:6:5 quantization and a +/-1 endpoint polish.
// BCN_POLISH_ITERS comes from TextureCompressLineFit.bslinc.
#include "$ENGINE$\TextureCompression\TextureCompressLineFit.bslinc"

mixin TextureCompressBC1
{
	code
	{
		#define BLOCKS_PER_GROUP 4u

		// Entries per block in groupshared memory. One more than a block has, so that threads reading the same entry of
		// different blocks hit different banks.
		#define TEXEL_STRIDE 17u

		groupshared float3 gGroupTexels[BLOCKS_PER_GROUP * TEXEL_STRIDE];

		uint PackColor565(float3 color)
		{
			uint r = (uint)round(saturate(color.r) * 31.0f);
			uint g = (uint)round(saturate(color.g) * 63.0f);
			uint b = (uint)round(saturate(color.b) * 31.0f);
			return (r << 11) | (g << 5) | b;
		}

		float3 Unpack565(uint c)
		{
			// Expand to 8-bit using bit replication, matching the hardware BCn decoder.
			// A plain divide (c/31) does NOT match the decoder and biases index selection.
			uint r5 = (c >> 11) & 0x1F;
			uint g6 = (c >> 5) & 0x3F;
			uint b5 = c & 0x1F;
			uint r8 = (r5 << 3) | (r5 >> 2);
			uint g8 = (g6 << 2) | (g6 >> 4);
			uint b8 = (b5 << 3) | (b5 >> 2);
			return float3(r8, g8, b8) / 255.0f;
		}

		// Decodes one channel of a 5:6:5 code, matching Unpack565. Channel 1 (green) has 6 bits, the others 5.
		float UnpackBC1Channel(int code, uint channel)
		{
			return (float)((channel == 1u) ? ((code << 2) | (code >> 4)) : ((code << 3) | (code >> 2))) / 255.0f;
		}

		int3 SplitBC1Codes(uint code)
		{
			return int3((int)((code >> 11) & 0x1Fu), (int)((code >> 5) & 0x3Fu), (int)(code & 0x1Fu));
		}

		uint JoinBC1Codes(int3 codes)
		{
			return ((uint)codes.x << 11) | ((uint)codes.y << 5) | (uint)codes.z;
		}

		// Blend factor toward the second endpoint of a 4-color index: indices 0, 1, 2, 3 decode to e0, e1, 2/3 e0 + 1/3
		// e1 and 1/3 e0 + 2/3 e1
		float GetBC1FourColorWeight(uint index)
		{
			return (index == 0u) ? 0.0f : ((index == 1u) ? 1.0f : ((index == 2u) ? (1.0f / 3.0f) : (2.0f / 3.0f)));
		}

		// Returns the dominant eigenvector of the covariance of the block whose texels start at @p texelBase, found by
		// power iteration. Seeded with the bounding box diagonal so flat blocks still get a sane axis.
		float3 FindBC1PrincipalAxis(uint texelBase, float3 mean, float3 minimum, float3 maximum)
		{
			float cxx = 0, cxy = 0, cxz = 0, cyy = 0, cyz = 0, czz = 0;
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
			{
				const float3 d = gGroupTexels[texelBase + texelIndex] - mean;
				cxx += d.x * d.x; cxy += d.x * d.y; cxz += d.x * d.z;
				cyy += d.y * d.y; cyz += d.y * d.z; czz += d.z * d.z;
			}

			float3 axis = maximum - minimum;
			if (dot(axis, axis) < 1e-8f)
				axis = float3(1, 1, 1);

			for (uint iteration = 0u; iteration < 8u; ++iteration)
			{
				float3 v;
				v.x = cxx * axis.x + cxy * axis.y + cxz * axis.z;
				v.y = cxy * axis.x + cyy * axis.y + cyz * axis.z;
				v.z = cxz * axis.x + cyz * axis.y + czz * axis.z;
				const float m = max(max(abs(v.x), abs(v.y)), abs(v.z));
				axis = (m > 1e-7f) ? (v / m) : axis;
			}

			return axis;
		}

		// Solves the least-squares endpoints for a split of the sorted texels into the four palette levels, given each
		// level's texel count and sum, and returns the split's squared error (1e30 if the system is singular).
		// @p squaredSum is the sum of the squared texels.
		float SolveBC1Split(float count0, float count1, float count2, float count3, float3 sum0, float3 sum1, float3 sum2, float3 sum3,
			float squaredSum, out float3 outEndpoint0, out float3 outEndpoint1)
		{
			// Normal-equation coefficients for the blend factors (1-w) = {1, 2/3, 1/3, 0} per level
			const float a = count0 + count1 * (4.0f / 9.0f) + count2 * (1.0f / 9.0f);
			const float c = count1 * (1.0f / 9.0f) + count2 * (4.0f / 9.0f) + count3;
			const float b = (count1 + count2) * (2.0f / 9.0f);
			const float determinant = a * c - b * b;

			outEndpoint0 = float3(0, 0, 0);
			outEndpoint1 = float3(0, 0, 0);
			if (!(determinant > 1e-9f))
				return 1e30f;

			const float3 rightA = sum0 + sum1 * (2.0f / 3.0f) + sum2 * (1.0f / 3.0f);
			const float3 rightB = sum1 * (1.0f / 3.0f) + sum2 * (2.0f / 3.0f) + sum3;
			const float inverseDeterminant = 1.0f / determinant;
			const float3 e0 = (c * rightA - b * rightB) * inverseDeterminant;
			const float3 e1 = (a * rightB - b * rightA) * inverseDeterminant;
			outEndpoint0 = e0;
			outEndpoint1 = e1;

			// Reconstructed palette value per level, and the resulting total squared error
			const float3 r1 = (2.0f / 3.0f) * e0 + (1.0f / 3.0f) * e1;
			const float3 r2 = (1.0f / 3.0f) * e0 + (2.0f / 3.0f) * e1;
			return squaredSum
				- 2.0f * (dot(e0, sum0) + dot(r1, sum1) + dot(r2, sum2) + dot(e1, sum3))
				+ count0 * dot(e0, e0) + count1 * dot(r1, r1) + count2 * dot(r2, r2) + count3 * dot(e1, e1);
		}

		// Returns the 4-color indices of the block's texels for 5:6:5 endpoints @p code0 and @p code1, and their squared
		// error
		uint AssignBC1FourColorIndices(uint texelBase, uint code0, uint code1, out float outError)
		{
			const float3 palette0 = Unpack565(code0);
			const float3 palette1 = Unpack565(code1);
			const float3 palette2 = (2.0f * palette0 + palette1) / 3.0f;
			const float3 palette3 = (palette0 + 2.0f * palette1) / 3.0f;

			uint indices = 0u;
			outError = 0.0f;
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
			{
				const float3 texel = gGroupTexels[texelBase + texelIndex];
				const float3 d0 = texel - palette0, d1 = texel - palette1, d2 = texel - palette2, d3 = texel - palette3;
				const float distance0 = dot(d0, d0), distance1 = dot(d1, d1), distance2 = dot(d2, d2), distance3 = dot(d3, d3);

				uint index = 0u;
				float distance = distance0;
				if (distance1 < distance) { distance = distance1; index = 1u; }
				if (distance2 < distance) { distance = distance2; index = 2u; }
				if (distance3 < distance) { distance = distance3; index = 3u; }

				indices |= index << (texelIndex * 2u);
				outError += distance;
			}

			return indices;
		}

		// Returns the 3-color indices of the block's texels for the palette {c0, c1, (c0 + c1) / 2, black}, and their
		// squared error
		uint AssignBC1ThreeColorIndices(uint texelBase, uint code0, uint code1, out float outError)
		{
			const float3 palette0 = Unpack565(code0);
			const float3 palette1 = Unpack565(code1);
			const float3 palette2 = (palette0 + palette1) * 0.5f;

			uint indices = 0u;
			outError = 0.0f;
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
			{
				const float3 texel = gGroupTexels[texelBase + texelIndex];
				const float3 d0 = texel - palette0, d1 = texel - palette1, d2 = texel - palette2;
				const float distance0 = dot(d0, d0), distance1 = dot(d1, d1), distance2 = dot(d2, d2), distance3 = dot(texel, texel);

				uint index = 0u;
				float distance = distance0;
				if (distance1 < distance) { distance = distance1; index = 1u; }
				if (distance2 < distance) { distance = distance2; index = 2u; }
				if (distance3 < distance) { distance = distance3; index = 3u; }

				indices |= index << (texelIndex * 2u);
				outError += distance;
			}

			return indices;
		}

		// Squared error of each polish candidate, per block
		groupshared float gPolishErrors[BLOCKS_PER_GROUP * 27u];

		// With the indices fixed, nudges each 5:6:5 channel code of both endpoints by -1/0/+1 and keeps the pair with the
		// lowest squared error. Recovers error the float least-squares fit loses to quantization. The error is separable per
		// channel, so the 27 candidates (3 channels x 3 x 3 nudges) are independent, and the 16 threads of the block
		// (@p lane) split them. @p isThreeColor selects the 3-color palette, whose index 3 decodes to black. Synchronizes
		// the group, so every thread of the group must call it.
		void PolishBC1Endpoints(uint texelBase, uint blockInGroup, uint lane, uint indices, bool isThreeColor, inout uint code0, inout uint code1)
		{
			const int3 codes0 = SplitBC1Codes(code0);
			const int3 codes1 = SplitBC1Codes(code1);
			const int3 maximumCodes = int3(31, 63, 31);

			// Candidate N nudges channel N / 9, the first endpoint by (N % 9) / 3 - 1 and the second by N % 3 - 1
			for (uint candidate = lane; candidate < 27u; candidate += 16u)
			{
				const uint channel = candidate / 9u;
				const int candidate0 = clamp(codes0[channel] + (int)((candidate % 9u) / 3u) - 1, 0, maximumCodes[channel]);
				const int candidate1 = clamp(codes1[channel] + (int)(candidate % 3u) - 1, 0, maximumCodes[channel]);
				const float value0 = UnpackBC1Channel(candidate0, channel);
				const float value1 = UnpackBC1Channel(candidate1, channel);

				float error = 0.0f;
				for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
				{
					const uint index = (indices >> (texelIndex * 2u)) & 3u;
					float paletteValue;
					if (isThreeColor)
						paletteValue = (index == 0u) ? value0 : ((index == 1u) ? value1 : ((index == 2u) ? (value0 + value1) * 0.5f : 0.0f));
					else
					{
						const float weight = GetBC1FourColorWeight(index);
						paletteValue = (1.0f - weight) * value0 + weight * value1;
					}

					const float difference = gGroupTexels[texelBase + texelIndex][channel] - paletteValue;
					error += difference * difference;
				}

				gPolishErrors[blockInGroup * 27u + candidate] = error;
			}

			GroupMemoryBarrierWithGroupSync();

			// The lowest-error candidate of each channel, with ties going to the first
			int3 selected0;
			int3 selected1;
			[unroll]
			for (uint channel = 0u; channel < 3u; ++channel)
			{
				uint bestCandidate = channel * 9u;
				for (uint candidate = channel * 9u + 1u; candidate < channel * 9u + 9u; ++candidate)
				{
					if (gPolishErrors[blockInGroup * 27u + candidate] < gPolishErrors[blockInGroup * 27u + bestCandidate])
						bestCandidate = candidate;
				}

				selected0[channel] = clamp(codes0[channel] + (int)((bestCandidate % 9u) / 3u) - 1, 0, maximumCodes[channel]);
				selected1[channel] = clamp(codes1[channel] + (int)(bestCandidate % 3u) - 1, 0, maximumCodes[channel]);
			}

			// The next polish overwrites the errors
			GroupMemoryBarrierWithGroupSync();

			code0 = JoinBC1Codes(selected0);
			code1 = JoinBC1Codes(selected1);
		}

		// Quantizes the cluster fit endpoints to a 4-color block, polishes them, and returns the block and its squared error.
		// Runs on all 16 threads of the block, which return the same block. Synchronizes the group, so every thread of the
		// group must call it.
		uint2 FinishBC1FourColor(uint texelBase, uint blockInGroup, uint lane, float3 endpoint0, float3 endpoint1, out float outError)
		{
			uint code0 = PackColor565(endpoint0);
			uint code1 = PackColor565(endpoint1);
			uint indices = AssignBC1FourColorIndices(texelBase, code0, code1, outError);
			for (uint polishIteration = 0u; polishIteration < BCN_POLISH_ITERS; ++polishIteration)
			{
				PolishBC1Endpoints(texelBase, blockInGroup, lane, indices, false, code0, code1);
				indices = AssignBC1FourColorIndices(texelBase, code0, code1, outError);
			}

			// 4-color mode requires c0 > c1. Swapping the endpoints swaps palette entries 0 and 1, and 2 and 3, so the low
			// bit of every index flips.
			if (code0 < code1)
			{
				const uint swappedCode = code0;
				code0 = code1;
				code1 = swappedCode;
				indices ^= 0x55555555u;
			}

			return uint2(code0 | (code1 << 16), indices);
		}

		// Encodes the block in the 3-color mode, whose palette is {c0, c1, (c0 + c1) / 2, black}: a block with dark texels
		// can route them to black and fit both endpoints to the other colors. Seeded from the cluster fit endpoints.
		// Returns the block and its squared error. Only valid for BC1: a BC3 color block always decodes as 4-color. Runs on
		// all 16 threads of the block, which return the same block. Synchronizes the group, so every thread of the group
		// must call it.
		uint2 FinishBC1ThreeColor(uint texelBase, uint blockInGroup, uint lane, float3 endpoint0, float3 endpoint1, out float outError)
		{
			// Iterated Lloyd fit: assign each texel to the nearest of {e0, e1, mid, black}, then least-squares refit e0 and
			// e1 over the texels not assigned to black (blend weights 0, 1 and 1/2)
			for (uint iteration = 0u; iteration < 3u; ++iteration)
			{
				const float3 middle = (endpoint0 + endpoint1) * 0.5f;
				float a = 0, b = 0, c = 0;
				float3 rightA = float3(0, 0, 0), rightB = float3(0, 0, 0);
				for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
				{
					const float3 texel = gGroupTexels[texelBase + texelIndex];
					const float3 d0 = texel - endpoint0, d1 = texel - endpoint1, dm = texel - middle;
					const float distance0 = dot(d0, d0), distance1 = dot(d1, d1), distanceMiddle = dot(dm, dm), distanceBlack = dot(texel, texel);

					float distance = distance0;
					float weight = 0.0f;
					if (distance1 < distance) { distance = distance1; weight = 1.0f; }
					if (distanceMiddle < distance) { distance = distanceMiddle; weight = 0.5f; }
					if (!(distanceBlack < distance))
					{
						const float weightA = 1.0f - weight;
						a += weightA * weightA; b += weightA * weight; c += weight * weight;
						rightA += weightA * texel; rightB += weight * texel;
					}
				}

				const float determinant = a * c - b * b;
				if (!(determinant > 1e-9f))
					break; // Degenerate, e.g. every texel snapped to black. Keeps the current endpoints.

				const float inverseDeterminant = 1.0f / determinant;
				endpoint0 = saturate((c * rightA - b * rightB) * inverseDeterminant);
				endpoint1 = saturate((a * rightB - b * rightA) * inverseDeterminant);
			}

			uint code0 = PackColor565(endpoint0);
			uint code1 = PackColor565(endpoint1);
			uint indices = AssignBC1ThreeColorIndices(texelBase, code0, code1, outError);
			for (uint polishIteration = 0u; polishIteration < BCN_POLISH_ITERS; ++polishIteration)
			{
				PolishBC1Endpoints(texelBase, blockInGroup, lane, indices, true, code0, code1);
				indices = AssignBC1ThreeColorIndices(texelBase, code0, code1, outError);
			}

			// The 3-color mode requires c0 <= c1. Order the endpoints and assign the indices for the ordered palette.
			const uint lowCode = min(code0, code1);
			const uint highCode = max(code0, code1);
			indices = AssignBC1ThreeColorIndices(texelBase, lowCode, highCode, outError);
			return uint2(lowCode | (highCode << 16), indices);
		}
	};
};
