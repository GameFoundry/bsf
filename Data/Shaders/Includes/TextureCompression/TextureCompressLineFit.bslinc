// Pass counts shared by the BCn encoders. Guarded so the headers that include this file don't redefine them.

// Number of endpoint-fit passes every BCn encoder runs. Each pass quantizes the current endpoints, assigns indices,
// and (on all but the last pass) least-squares-refines the endpoints against those indices, letting endpoints and
// indices co-adapt. More passes converge closer to the local optimum for a few extra ALU ops per block.
//
// IMPORTANT: the per-pass loop in every encoder is a RUNTIME loop, deliberately NOT [unroll]'d, because
// compiling such a large shader seems to be hanging AMD's Vulkan driver.
#ifndef BCN_REFINE_PASSES
	#define BCN_REFINE_PASSES 4
#endif

// Number of ±1 endpoint-polish iterations BC1 runs after its cluster fit. Each iteration, with the per-texel indices
// held fixed, tries every endpoint code at -1/0/+1 and keeps the lowest-error choice (squared error is separable per
// channel, so this is cheap), then re-assigns indices. This recovers error lost to the rounding step that the continuous
// least-squares solve cannot see. 0 disables the polish.
#ifndef BCN_POLISH_ITERS
	#define BCN_POLISH_ITERS 2
#endif
