// BC4 encoder: a 4x4 single-channel block -> a 64-bit block in the 8-value interpolated mode (r0 > r1). Endpoints start
// at the value extent, are least-squares (Lloyd) refined over the assigned indices, then a joint endpoint-window search
// escapes the local minimum. Reused by BC3 (alpha) and BC5 (R and G). BCN_REFINE_PASSES comes from
// TextureCompressLineFit.bslinc.
#include "$ENGINE$\TextureCompression\TextureCompressLineFit.bslinc"

mixin TextureCompressBC4
{
	code
	{
		// The endpoint window search tries every pair of 8-bit codes within this distance of the refined endpoints
		#define BC4_WINDOW_RADIUS 8
		#define BC4_WINDOW_WIDTH (2 * BC4_WINDOW_RADIUS + 1)
		#define BC4_WINDOW_CANDIDATE_COUNT (BC4_WINDOW_WIDTH * BC4_WINDOW_WIDTH)

		// Returns the 8-bit endpoint codes of the block, starting at the value extent and least-squares refined over
		// the assigned indices
		void RefineBC4Endpoints(float texels[16], out uint outCode0, out uint outCode1)
		{
			float minimum = texels[0];
			float maximum = texels[0];
			[unroll]
			for (uint texelIndex = 1u; texelIndex < 16u; ++texelIndex)
			{
				minimum = min(minimum, texels[texelIndex]);
				maximum = max(maximum, texels[texelIndex]);
			}

			// Maps each 3-bit index to its blend factor toward the second endpoint
			float indexWeights[8];
			indexWeights[0] = 0.0f; indexWeights[1] = 1.0f;
			indexWeights[2] = 1.0f / 7.0f; indexWeights[3] = 2.0f / 7.0f; indexWeights[4] = 3.0f / 7.0f;
			indexWeights[5] = 4.0f / 7.0f; indexWeights[6] = 5.0f / 7.0f; indexWeights[7] = 6.0f / 7.0f;

			// Each pass assigns indices against the quantized endpoints, then solves the endpoints that minimize the error
			// for those indices. Runtime loop (not [unroll]), because we're seeing hangs when compiling this shader on AMD.
			for (uint refinePass = 0u; refinePass + 1u < BCN_REFINE_PASSES; ++refinePass)
			{
				const float value0 = (uint)round(saturate(maximum) * 255.0f) / 255.0f;
				const float value1 = (uint)round(saturate(minimum) * 255.0f) / 255.0f;

				float palette[8];
				palette[0] = value0;
				palette[1] = value1;
				[unroll]
				for (uint level = 1u; level < 7u; ++level)
					palette[level + 1u] = ((7 - level) * value0 + level * value1) / 7.0f;

				// Normal equations of the endpoints, given the nearest palette entry of each texel
				float a = 0, b = 0, c = 0, sumA = 0, sumB = 0;
				[unroll]
				for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
				{
					const float value = texels[texelIndex];
					uint bestIndex = 0u;
					float bestDistance = 1e20f;
					[unroll]
					for (uint index = 0u; index < 8u; ++index)
					{
						const float difference = value - palette[index];
						const float distance = difference * difference;
						if (distance < bestDistance)
						{
							bestDistance = distance;
							bestIndex = index;
						}
					}

					const float weight = indexWeights[bestIndex];
					const float weightA = 1.0f - weight;
					a += weightA * weightA; b += weightA * weight; c += weight * weight;
					sumA += weightA * value;
					sumB += weight * value;
				}

				const float determinant = a * c - b * b;
				if (abs(determinant) > 1e-7f)
				{
					const float inverseDeterminant = 1.0f / determinant;
					const float endpoint0 = (c * sumA - b * sumB) * inverseDeterminant;
					const float endpoint1 = (-b * sumA + a * sumB) * inverseDeterminant;

					// Keeps the first endpoint the larger one, so the block stays in the 8-value mode. The next pass assigns
					// fresh indices against the ordered palette, so no remap is needed.
					maximum = saturate(max(endpoint0, endpoint1));
					minimum = saturate(min(endpoint0, endpoint1));
				}
			}

			outCode0 = (uint)round(saturate(maximum) * 255.0f);
			outCode1 = (uint)round(saturate(minimum) * 255.0f);
		}

		// Returns endpoint codes number @p candidate of the window around @p baseCode0 and @p baseCode1. Candidates are
		// numbered in order of the first code's offset, then the second's.
		uint2 GetBC4WindowCodes(uint baseCode0, uint baseCode1, uint candidate)
		{
			const int offset0 = (int)(candidate / BC4_WINDOW_WIDTH) - BC4_WINDOW_RADIUS;
			const int offset1 = (int)(candidate % BC4_WINDOW_WIDTH) - BC4_WINDOW_RADIUS;
			return uint2(clamp((int)baseCode0 + offset0, 0, 255), clamp((int)baseCode1 + offset1, 0, 255));
		}

		// Returns the squared error of the block for endpoint codes @p code0 and @p code1, with each texel assigned its
		// nearest level. The levels are evenly spaced, so the nearest one is the rounded projection onto the ramp.
		float GetBC4Error(float texels[16], uint code0, uint code1)
		{
			const float value0 = code0 / 255.0f;
			const float value1 = code1 / 255.0f;
			const float difference = value1 - value0;
			const float inverseStep = (abs(difference) > 1e-6f) ? (7.0f / difference) : 0.0f;

			float error = 0;
			[unroll]
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
			{
				const float value = texels[texelIndex];
				const float level = clamp(round((value - value0) * inverseStep), 0.0f, 7.0f);
				const float reconstruction = value0 + level * difference / 7.0f;
				const float texelError = value - reconstruction;
				error += texelError * texelError;
			}

			return error;
		}

		// Assigns each texel its nearest palette entry for endpoint codes @p code0 and @p code1, and packs the block
		uint2 PackBC4(float texels[16], uint code0, uint code1)
		{
			// 8-value mode requires r0 >= r1. The palette set is identical under a swap, so reorder and assign fresh
			// indices (no remap needed).
			if (code0 < code1)
			{
				const uint swappedCode = code0;
				code0 = code1;
				code1 = swappedCode;
			}

			const float value0 = code0 / 255.0f;
			const float value1 = code1 / 255.0f;
			float palette[8];
			palette[0] = value0;
			palette[1] = value1;
			[unroll]
			for (uint level = 1u; level < 7u; ++level)
				palette[level + 1u] = ((7 - level) * value0 + level * value1) / 7.0f;

			uint indicesLow = 0u;
			uint indicesHigh = 0u;
			[unroll]
			for (uint texelIndex = 0u; texelIndex < 16u; ++texelIndex)
			{
				uint bestIndex = 0u;
				float bestDistance = 1e20f;
				[unroll]
				for (uint index = 0u; index < 8u; ++index)
				{
					const float difference = texels[texelIndex] - palette[index];
					const float distance = difference * difference;
					if (distance < bestDistance)
					{
						bestDistance = distance;
						bestIndex = index;
					}
				}

				const uint bitOffset = texelIndex * 3u;
				if (bitOffset < 32u)
				{
					indicesLow |= bestIndex << bitOffset;
					if (bitOffset + 3u > 32u)
						indicesHigh |= bestIndex >> (32u - bitOffset);
				}
				else
					indicesHigh |= bestIndex << (bitOffset - 32u);
			}

			// Block layout (little-endian): byte0 = r0, byte1 = r1, then 48 index bits
			const uint low = code0 | (code1 << 8) | (indicesLow << 16);
			const uint high = (indicesLow >> 16) | (indicesHigh << 16);
			return uint2(low, high);
		}

		// Encodes a 4x4 single-channel block into a 64-bit BC4 block. The joint endpoint window search assigns each
		// candidate pair fresh indices, so it explores different assignments globally and escapes the local minimum the
		// least-squares refinement converges to, which is the bulk of the quality gap to CPU encoders.
		uint2 CompressBC4(float texels[16])
		{
			uint baseCode0;
			uint baseCode1;
			RefineBC4Endpoints(texels, baseCode0, baseCode1);

			uint2 bestCodes = uint2(baseCode0, baseCode1);
			float bestError = 1e30f;
			[loop]
			for (uint candidate = 0u; candidate < BC4_WINDOW_CANDIDATE_COUNT; ++candidate)
			{
				const uint2 codes = GetBC4WindowCodes(baseCode0, baseCode1, candidate);
				const float error = GetBC4Error(texels, codes.x, codes.y);
				if (error < bestError)
				{
					bestError = error;
					bestCodes = codes;
				}
			}

			return PackBC4(texels, bestCodes.x, bestCodes.y);
		}
	};
};
